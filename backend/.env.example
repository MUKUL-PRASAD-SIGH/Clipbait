# Environment Configuration
NODE_ENV=development
PORT=3000

# Database Configuration (set SKIP_DATABASE=true for in-memory storage)
DATABASE_URL=postgresql://epitychia_user:epitychia_password@localhost:5432/epitychia
SKIP_DATABASE=true

# Security (Generate your own secure keys)
JWT_SECRET=your-jwt-secret-key-here
ENCRYPTION_KEY=your-encryption-key-here

# Firebase Configuration (Replace with your own values)
FIREBASE_API_KEY=your-firebase-api-key-here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id
FIREBASE_PRIVATE_KEY="your-firebase-private-key-here"
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# AI Services - Using Hugging Face (Free)
HUGGINGFACE_API_KEY=hf_your_key_here
USE_HUGGINGFACE=true

# Frontend URL
FRONTEND_URL=http://localhost:3001